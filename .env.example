# Copy to .env (local runs) or .env.local (docker compose) and fill in.

# Signing key for session JWTs. REQUIRED. Generate a strong random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# GitHub OAuth application credentials.
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URL=

# Redis host (used directly as a hostname, not a URL).
REDIS_URL=redis

# MySQL connection.
MYSQL_DB_HOST=mysql
MYSQL_DB_USER=root
MYSQL_DB_PASS=password
MYSQL_DB_NAME=example
MYSQL_DB_PORT=3306
